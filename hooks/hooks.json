{
  "description": "Safety rails for the github-os workflow: block unsafe git pushes and verify-skipping commits.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-push-guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
